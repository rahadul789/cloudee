NODE_ENV=development
PORT=4200
WEBSITE_BASE_URL=http://localhost:4200
# Required in production; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use the same stable secret on all website instances. Never commit the real value.
WEBSITE_SESSION_SECRET=
# Play Console > App integrity > App signing certificate > SHA-256 fingerprint.
# Multiple fingerprints can be comma-separated. Leave empty until verified.
ANDROID_APP_LINK_SHA256=

# Existing Foodbela backend API. Website leads, analytics, and settings use this.
BACKEND_API_BASE_URL=http://localhost:5000/api/v1

# Optional override if you want to forward leads to a custom endpoint instead.
# BACKEND_LEADS_API_URL=https://api.foodbela.com/api/v1/website/leads
