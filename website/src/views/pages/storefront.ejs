<!doctype html>
<html lang="bn">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= seo.title %></title><meta name="description" content="<%= seo.description %>">
  <meta name="robots" content="<%= seo.robots %>"><link rel="canonical" href="<%= seo.canonicalUrl %>">
  <meta name="theme-color" content="#ffb84c">
  <meta property="og:title" content="<%= seo.title %>"><meta property="og:description" content="<%= seo.description %>">
  <meta property="og:url" content="<%= seo.canonicalUrl %>"><meta property="og:image" content="<%= seo.ogImageUrl %>">
  <meta property="og:type" content="website"><meta property="og:locale" content="bn_BD">
  <% if (seo.googleSiteVerification) { %><meta name="google-site-verification" content="<%= seo.googleSiteVerification %>"><% } %>
  <link rel="icon" href="/favicon.ico"><link rel="manifest" href="/site.webmanifest">
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali:wght@400;500;600;700;800&family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/storefront.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
  <script type="application/ld+json"><%- seo.structuredDataJson %></script>
</head>
<body data-page="<%= page %>">
  <a class="skip-link" href="#main">মূল কনটেন্টে যান</a>
  <header class="shop-header">
    <div class="location-bar">
    <button id="location-open" class="location-trigger"><span aria-hidden="true">⌖</span><span><small>ডেলিভারির ঠিকানা</small><strong id="location-label">লোকেশন বাছাই করুন</strong></span><span aria-hidden="true">⌄</span></button>
    </div>
    <div class="header-inner">
    <a href="/" class="brand" aria-label="Foodbela হোম"><span class="brand-icon"><img src="/images/Foodbela.svg" alt="" width="48" height="48"></span><span class="brand-word"><span class="brand-food">Food</span><span class="brand-bela">bela</span><span class="brand-dot">.</span></span></a>
    <nav aria-label="কাস্টমার নেভিগেশন"><a href="/restaurants">রেস্টুরেন্ট</a><a href="/orders">আমার অর্ডার</a><button id="auth-open" class="quiet">লগইন</button><button id="cart-open" class="cart-trigger">কার্ট <span id="cart-count">০</span></button></nav>
  </div></header>
  <div id="app-prompt" class="app-prompt" hidden><span>আপনার পছন্দের খাবার, Foodbela অ্যাপে।</span><a id="app-intent" href="https://play.google.com/store/apps/details?id=com.foodbela.app">অ্যাপে খুলুন / ইনস্টল করুন ↗</a><button id="app-dismiss" aria-label="অ্যাপের বার্তা বন্ধ করুন">×</button></div>
  <main id="main" class="shop-main">
    <div id="notice" class="notice" role="status" aria-live="polite" hidden></div>
    <% if (page === 'home') { %>
      <div class="discovery-layout">
        <details class="filter-panel" open><summary>ফিল্টার ও সাজানো <span aria-hidden="true">⌄</span></summary><aside class="discovery-filters" aria-label="রেস্টুরেন্ট ফিল্টার">
          <h2>ফিল্টার</h2>
          <fieldset><legend>সাজান</legend>
            <label><input type="radio" name="sort" value="" checked> ডিফল্ট</label>
            <label><input type="radio" name="sort" value="nearest"> দূরত্ব অনুযায়ী</label>
            <label><input type="radio" name="sort" value="topRated"> সেরা রেটিং</label>
            <label><input type="radio" name="sort" value="fastest"> প্রস্তুতির সময়</label>
          </fieldset>
          <fieldset><legend>রেস্টুরেন্ট</legend>
            <label><input type="radio" name="availability-filter" value="all" checked> সব রেস্টুরেন্ট</label>
            <label><input type="radio" name="availability-filter" value="open"> এখন খোলা</label>
            <label><input type="radio" name="availability-filter" value="offers"> অফার আছে</label>
          </fieldset>
          <fieldset><legend>খাবারের ধরন</legend><div id="cuisine-filters"><p class="muted">ক্যাটাগরি লোড হচ্ছে…</p></div></fieldset>
          <button id="reset-filters" class="quiet" type="button">সব ফিল্টার মুছুন</button>
        </aside></details>
        <div class="discovery-main">
          <h1 class="sr-only">নেত্রকোনায় Foodbela খাবার ডেলিভারি</h1>
          <form id="search-form" class="search-box" role="search"><label class="sr-only" for="search">খাবার বা রেস্টুরেন্ট খুঁজুন</label><span aria-hidden="true">⌕</span><input id="search" name="search" type="search" maxlength="100" placeholder="খাবার বা রেস্টুরেন্ট খুঁজুন…"><button type="button" id="search-clear" class="search-clear" aria-label="সার্চের লেখা মুছুন" hidden>×</button><button type="submit">খুঁজুন</button></form>
          <div id="cms-content"></div>
          <section id="restaurant-section"><div class="section-heading"><div class="search-results-heading"><h2 id="restaurant-title">সব রেস্টুরেন্ট</h2><button type="button" id="results-clear" class="results-clear" hidden>মুছুন ×</button></div><select id="restaurant-filter" aria-label="রেস্টুরেন্ট ফিল্টার"><option value="all">সব রেস্টুরেন্ট</option><option value="open">এখন খোলা</option><option value="offers">অফার আছে</option></select></div>
          <p id="coverage-note" class="muted">আপনার ঠিকানা নির্বাচন করলে ডেলিভারি পাওয়া যায় এমন রেস্টুরেন্ট দেখাব।</p>
          <div id="restaurant-list" class="restaurant-grid">
            <% const initialRestaurants = [...new Map([...(catalog?.items || []), ...(discovery?.featuredRestaurants || []), ...(discovery?.nearbyRestaurants || []), ...(discovery?.discoverNewRestaurants || [])].map(r => [r._id, r])).values()]; initialRestaurants.forEach(r => { %>
              <%- restaurantCard(r) %>
            <% }); %>
          </div><button id="load-more" class="secondary" hidden>আরও রেস্টুরেন্ট দেখুন</button></section>
        </div>
      </div>
    <% } else if (page === 'restaurant') { %>
      <a href="/restaurants" class="back-link">← সব রেস্টুরেন্ট</a>
      <div id="restaurant-detail">
        <% if (restaurantData) { %><section class="restaurant-hero"><h1><%= restaurantData.restaurant.name %></h1><p><%= restaurantData.restaurant.description || '' %></p></section><div class="menu-grid"><% restaurantData.menuItems.forEach(item => { %><article class="menu-card"><h2><%= item.name %></h2><p><%= item.description || '' %></p><strong>৳<%= item.markdown?.effectivePrice ?? item.basePrice %></strong></article><% }); %></div><% } %>
      </div>
    <% } else if (page === 'checkout') { %><div id="checkout-content"></div>
    <% } else { %><div id="orders-content"></div><% } %>
    <noscript><p class="notice">কার্ট, লোকেশন ও অর্ডার ব্যবহার করতে browser-এ JavaScript চালু করুন। <a href="/download">Foodbela অ্যাপও ব্যবহার করতে পারেন।</a></p></noscript>
    <% if (loadError) { %><p class="notice"><%= loadError %></p><% } %>
  </main>
  <%- include('../partials/footer') %>
  <nav class="mobile-tabbar" aria-label="মোবাইল নেভিগেশন">
    <a href="/" <%- page === 'home' ? 'aria-current="page"' : '' %>><span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m3 10 9-7 9 7v10H3V10Z M9 20v-7h6v7"/></svg></span>হোম</a>
    <button type="button" id="mobile-cart-open"><span class="mobile-cart-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 7h16l-1 14H5L4 7Z M8 7V6a4 4 0 0 1 8 0v1"/></svg><b id="mobile-cart-count">০</b></span>কার্ট</button>
    <a href="/orders" <%- page === 'orders' ? 'aria-current="page"' : '' %>><span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 3h12v18l-3-2-3 2-3-2-3 2V3Z M9 8h6 M9 12h6"/></svg></span>অর্ডার</a>
    <button type="button" id="mobile-auth-open"><span aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></svg></span>অ্যাকাউন্ট</button>
  </nav>
  <dialog id="location-dialog" class="shop-dialog"><div class="dialog-heading"><h2>কোথায় খাবার পৌঁছে দেব?</h2><button type="button" data-close aria-label="বন্ধ করুন">×</button></div><p class="muted">সঠিক ডেলিভারি পয়েন্ট বেছে নিয়ে ঠিকানা নিশ্চিত করুন।</p><button id="use-gps" class="primary wide">⌖ বর্তমান লোকেশন ব্যবহার করুন</button><p id="location-status" role="status"></p><div id="location-map" aria-label="ডেলিভারির জায়গা বাছাইয়ের ম্যাপ"></div><form id="location-form"><div class="field-row"><label>অক্ষাংশ<input name="latitude" type="number" step="any" min="-90" max="90" required></label><label>দ্রাঘিমাংশ<input name="longitude" type="number" step="any" min="-180" max="180" required></label></div><label>ডেলিভারির ঠিকানা<input name="address" maxlength="240" required placeholder="এলাকা, রাস্তা, বাড়ির নাম"></label><label>অতিরিক্ত নির্দেশনা<input name="addressDetails" maxlength="240" placeholder="ফ্ল্যাট, তলা, কাছের পরিচিত জায়গা"></label><button type="submit" class="primary wide">এই ঠিকানা নিশ্চিত করুন</button></form><div id="saved-locations"></div></dialog>
  <dialog id="auth-dialog" class="shop-dialog"><div class="dialog-heading"><h2>Foodbela-তে স্বাগতম</h2><button type="button" data-close aria-label="বন্ধ করুন">×</button></div><div id="auth-content"></div><p id="auth-status" role="status"></p></dialog>
  <dialog id="item-dialog" class="shop-dialog"><div class="dialog-heading"><h2 id="item-title">খাবার বাছাই</h2><button type="button" data-close aria-label="বন্ধ করুন">×</button></div><form id="item-form"></form></dialog>
  <dialog id="cart-dialog" class="shop-dialog cart-dialog"><div class="dialog-heading"><h2>আপনার কার্ট</h2><button type="button" data-close aria-label="বন্ধ করুন">×</button></div><div id="cart-content"></div></dialog>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js" defer></script>
  <script src="/js/storefront.js" type="module"></script>
</body></html>
